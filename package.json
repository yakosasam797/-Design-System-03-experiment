{
  "name": "@paryatech/design-system",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Paryatech design system — tokens, UI components, and list patterns",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yakosasam797/-Design-System-03-experiment.git"
  },
  "homepage": "https://github.com/yakosasam797/-Design-System-03-experiment#readme",
  "bugs": {
    "url": "https://github.com/yakosasam797/-Design-System-03-experiment/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./tokens.css": "./src/tokens/tokens.css",
    "./typography.css": "./src/tokens/typography.css",
    "./styles.css": "./dist/design-system.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src/tokens",
    "README.md",
    "AGENTS.md",
    "docs/usage"
  ],
  "sideEffects": [
    "**/*.css",
    "./dist/index.js"
  ],
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly",
    "prepare": "npm run build",
    "dev": "storybook dev -p 6006",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/react": "^8.6.14",
    "@storybook/react-vite": "^8.6.14",
    "@storybook/test": "^8.6.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^26.1.0",
    "playwright": "^1.63.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "storybook": "^8.6.14",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.5.0",
    "vitest": "^3.2.7"
  }
}
